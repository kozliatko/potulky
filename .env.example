# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=tvly-...

# Backend
PORT=3001

# Caddy — e-mail pre Let's Encrypt notifikácie o expirácii certifikátu
CADDY_ACME_EMAIL=tvoj@email.sk

# Voliteľné: základná ochrana API (nastav vlastný token)
# API_SECRET_TOKEN=zmen-toto-na-vlastny-tajny-token
# Rovnaká hodnota ako API_SECRET_TOKEN — frontend ju posiela v hlavičke x-api-token
# VITE_API_SECRET_TOKEN=zmen-toto-na-vlastny-tajny-token
